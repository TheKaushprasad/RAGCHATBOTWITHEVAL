# Provider for chat + embeddings: "openai" or "gemini".
# Switching provider changes the embedding space, so re-run `python ingest.py` afterwards.
PROVIDER=openai

# OpenAI: https://platform.openai.com/api-keys  (paid, but this project costs cents)
OPENAI_API_KEY=
# Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Supabase → Project Settings → API. Use the service_role key (server-side only; never expose it to the browser).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=
# Supabase → Project Settings → API Keys → anon public (or Publishable) key. Sent to the browser for login only.
SUPABASE_ANON_KEY=

# Optional model overrides (defaults: openai gpt-4.1-mini / text-embedding-3-small; gemini gemini-2.5-flash / gemini-embedding-001)
# CHAT_MODEL=
# EMBED_MODEL=
# JUDGE_MODEL=            # eval_answers.py grader; defaults to CHAT_MODEL
# EMBED_DIM=768           # must match vector(768) in supabase/schema.sql

# Retrieval + chunking. TOP_K=5 chosen from the golden-set eval (results/golden vs results/golden-k5);
# chunking + threshold from the Tidepool sweep (examples/tidepool/results/tuning.md).
CHUNK_TOKENS=350
CHUNK_OVERLAP=50
RETRIEVAL_MODE=vector     # vector | hybrid
TOP_K=5
MIN_SIMILARITY=0.224      # top-1 similarity below this → "I don't know" without calling the LLM
